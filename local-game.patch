+// Continue only after the currently running generation batch finishes; never race two writers of the champion profile.
+const fs=require('node:fs');const report='../../outputs/evolution-report.json';
+const timer=setInterval(()=>{try{const r=JSON.parse(fs.readFileSync(report));if(r.running===false){clearInterval(timer);process.env.GENERATIONS='10';process.env.LEARN_WINNERS='1';console.log('Starting winner-observation + independent-validation batch');require('./lorkan-evolve.cjs');}}catch(e){if(e.code!=='ENOENT'){console.error(e.message);process.exitCode=1;clearInterval(timer)}}},15000);
+console.log('Waiting for the current training batch, then continue 10 generations with complete-game winner observation.');
