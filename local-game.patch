+import {GameType,GameMapType,GameMapSize,GameMode,Difficulty} from '@openfront/engine-api/game/GameTypes';
+import {createGameRunner} from './packages/engine/src/GameRunner';
+import {loadMapFiles} from '@openfront/shared/GameMapLoader';
+import {NodeGameMapLoader} from './tests/perf/fullgame/NodeGameMapLoader';
+import {lorkanDecision} from './packages/engine/src/LorkanPolicy';
+import fs from 'node:fs';
+import {createRequire} from 'node:module';
+const {analyze}=createRequire(import.meta.url)('../../outputs/Lorkan1/extension/replay-analysis.js');
+const out='../../outputs/winner-study';fs.mkdirSync(out,{recursive:true});const summaries:any[]=[];
+console.debug=()=>{};
+for(let i=0;i<Number(process.env.GAMES??2);i++){
+ const n=i+Number(process.env.STUDY_START??0);
+ const map=n%2?GameMapType.World:GameMapType.Europe;
+ const config:any={gameType:GameType.Singleplayer,gameMode:GameMode.FFA,gameMap:map,gameMapSize:GameMapSize.Compact,difficulty:Difficulty.Impossible,nations:12,bots:0,startingGold:0,infiniteGold:false,infiniteTroops:false,instantBuild:false,randomSpawn:false,donateGold:false,donateTroops:false};
+ const gameId='WINNER-STUDY-'+n,start:any={gameID:gameId,lobbyCreatedAt:0,config,players:[{clientID:'LOCALAI1',username:'Lorkan',clanTag:null,isLobbyCreator:true}]};
+ const r=await createGameRunner(start,'LOCALAI1',await loadMapFiles(new NodeGameMapLoader('resources/maps'),map,GameMapSize.Compact),u=>{if('errMsg'in u)throw Error(u.errMsg)}),g=r.game;
+ const samples:any[]=[];
+ function sample(){for(const p of g.allPlayers().filter(p=>p.hasSpawned())){const units:Record<string,number>={};for(const u of p.units())if(!u.isUnderConstruction())units[u.type()]=(units[u.type()]??0)+1;const outgoing=p.outgoingAttacks(),total=p.troops()+outgoing.reduce((s,a)=>s+a.troops(),0);samples.push({tick:g.ticks(),playerId:p.id(),tiles:p.numTilesOwned(),troops:Math.round(p.troops()),gold:String(p.gold()),trainGold:String(p.trainGold()),tradeGold:String(p.tradeGold()),units,attackRatios:outgoing.filter(a=>a.target().isPlayer()).map(a=>a.troops()/Math.max(1,total)),neutralRatios:outgoing.filter(a=>!a.target().isPlayer()).map(a=>a.troops()/Math.max(1,total))});}}
+ for(let t=0;t<Number(process.env.TICKS??15000);t++){
+  const a=lorkanDecision(g,'LOCALAI1',1);r.addTurn({turnNumber:t,intents:a?[{...a,clientID:'LOCALAI1'}]:[]});if(!r.executeNextTick())throw Error('Tick failed');
+  if(g.ticks()%100===0||g.getWinner())sample();
+  if(g.getWinner())break;
+ }
+ const winner:any=g.getWinner(),winnerId=winner&&typeof winner.id==='function'?winner.id():null;
+ const record={schema:'lorkan-observation-v1',source:'local-openfront-030274df6e377a57e784a9f6f9865720b0dfbbba',gameId,config,completed:winnerId!==null,winnerId,samples};
+ fs.writeFileSync(`${out}/${gameId}.json`,JSON.stringify(record));
+ const summary=winnerId?analyze(record):{gameId,completed:false,reason:'No engine-declared winner within tick limit'};summaries.push(summary);fs.writeFileSync(`${out}/summary.json`,JSON.stringify(summaries,null,2));
+ const eligible=summaries.filter(s=>s.winnerId);if(eligible.length){const last=eligible.at(-1);const clamp=(n:number,lo:number,hi:number)=>Math.max(lo,Math.min(hi,n));const proposal={provenance:eligible.map(s=>s.gameId),params:{expansionScale:last.medianObservedNeutralRatio===null?.75:clamp(last.medianObservedNeutralRatio/.14,.5,1.5),attackScale:1.2,cityTiles:clamp(Math.round(last.finalTiles/Math.max(1,last.finalUnits.City??0)),2500,7000)},note:'Observed winner-derived hypothesis; must pass independent validation before deployment'};fs.writeFileSync('../../outputs/winner-proposal.json',JSON.stringify(proposal,null,2));}
+ console.log(JSON.stringify({gameId,winnerId,ticks:g.ticks(),samples:samples.length}));
+}
diff --git a/packages/engine/src/LorkanArsenal.ts b/packages/engine/src/LorkanArsenal.ts
