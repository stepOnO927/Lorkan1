+// Controlled late-game fixture, NOT a win-rate benchmark: both sides start with mature territory and resources.
+import {GameType,GameMapType,GameMapSize,GameMode,Difficulty,UnitType} from '@openfront/engine-api/game/GameTypes';
+import {createGameRunner} from './packages/engine/src/GameRunner';
+import {loadMapFiles} from '@openfront/shared/GameMapLoader';
+import {NodeGameMapLoader} from './tests/perf/fullgame/NodeGameMapLoader';
+import {lorkanDecision} from './packages/engine/src/LorkanPolicy';
+import {ConstructionExecution} from './packages/engine/src/execution/ConstructionExecution';
+import fs from 'node:fs';
+const config:any={gameType:GameType.Singleplayer,gameMode:GameMode.FFA,gameMap:GameMapType.World,gameMapSize:GameMapSize.Compact,difficulty:Difficulty.Impossible,nations:'disabled',bots:0,startingGold:200000000,infiniteGold:false,infiniteTroops:false,instantBuild:false,randomSpawn:false,donateGold:false,donateTroops:false};
+const nukeMode=process.env.NUKE_ONLY;
+const allowed=nukeMode==='atom'?UnitType.AtomBomb:nukeMode==='mirv'?UnitType.MIRV:null;
+if(allowed)config.disabledUnits=[UnitType.AtomBomb,UnitType.HydrogenBomb,UnitType.MIRV].filter(u=>u!==allowed);
+const start:any={gameID:'CAPABILITY-FIXTURE',lobbyCreatedAt:0,config,players:['LOCALAI1','ENEMY001'].map(clientID=>({clientID,username:clientID,clanTag:null,isLobbyCreator:false}))};
+const r=await createGameRunner(start,'LOCALAI1',await loadMapFiles(new NodeGameMapLoader('resources/maps'),config.gameMap,config.gameMapSize),u=>{if('errMsg'in u)throw Error(u.errMsg)}),g=r.game;
+const p=g.playerByClientID('LOCALAI1')!,enemy=g.playerByClientID('ENEMY001')!;
+function nearest(x:number,y:number){for(let radius=0;radius<100;radius++)for(let dx=-radius;dx<=radius;dx++){const yy=y+radius,xx=x+dx;if(g.isValidCoord(xx,yy)&&g.isLand(g.ref(xx,yy)))return g.ref(xx,yy);}throw Error('land missing');}
+r.addTurn({turnNumber:0,intents:[{type:'spawn',clientID:'LOCALAI1',tile:nearest(250,150)},{type:'spawn',clientID:'ENEMY001',tile:nearest(760,120)}]});r.executeNextTick();
+for(let wait=0;wait<5;wait++){r.addTurn({turnNumber:g.ticks(),intents:[]});r.executeNextTick();}
+for(let y=0;y<g.height();y++)for(let x=0;x<g.width();x++){const tile=g.ref(x,y);if(g.isLand(tile)){const owner=g.owner(tile);if(owner.isPlayer())owner.relinquish(tile);(x<g.width()/2?p:enemy).conquer(tile);}}
+for(const owner of [p,enemy]){
+ owner.removeGold(owner.gold());owner.addGold(200000000n);const tiles=[...owner.tiles()];let added=0;
+ for(const type of [UnitType.City,UnitType.City,UnitType.City,UnitType.City,UnitType.City,UnitType.City,UnitType.MissileSilo]){
+  for(let k=0;k<300;k++){const tile=tiles[(k*997+added*101)%tiles.length];const valid=owner.canBuild(type,tile);if(valid!==false){g.addExecution(new ConstructionExecution(owner,type,valid));for(let wait=0;wait<3;wait++){r.addTurn({turnNumber:g.ticks(),intents:[]});r.executeNextTick();}added++;break;}}
+ }
+}
+const actions:any={},seen=new Set<string>();let maxConnected=0,maxTrain=0n,maxTrade=0n,maxShips=0;
+for(let t=1;t<=2400;t++){
+ const a=lorkanDecision(g,'LOCALAI1',1);if(a){const key=a.type==='build_unit'?a.unit:a.type;actions[key]=(actions[key]??0)+1;}
+ r.addTurn({turnNumber:g.ticks(),intents:a?[{...a,clientID:'LOCALAI1'}]:[]});if(!r.executeNextTick())throw Error('tick failed');
+ for(const u of p.units())seen.add(u.type());maxShips=Math.max(maxShips,p.units(UnitType.Warship).length);
+ maxTrain=p.trainGold()>maxTrain?p.trainGold():maxTrain;maxTrade=p.tradeGold()>maxTrade?p.tradeGold():maxTrade;
+ if(t%100===0)maxConnected=Math.max(maxConnected,[...g.railNetwork().stationManager().getAll()].filter(s=>s.unit.owner()===p&&s.getRailroads().size>0).length);
+}
+const result={nukeMode:nukeMode??'default',fixture:'Mature territory + equal 200M starting gold; enemy stationary; not a competition',actions,seen:[...seen],maxConnected,maxShips,trainGold:String(maxTrain),tradeGold:String(maxTrade)};
+fs.writeFileSync(`../../outputs/capabilities-${nukeMode??'v03'}.json`,JSON.stringify(result,null,2));console.log(JSON.stringify(result));
+if(!seen.has(UnitType.Factory)||maxConnected===0||maxTrain===0n||!seen.has(UnitType.SAMLauncher)||!seen.has(UnitType.Warship)||![UnitType.AtomBomb,UnitType.HydrogenBomb,UnitType.MIRV].some(t=>seen.has(t)))throw Error('Capability validation incomplete');
+if(allowed&&!seen.has(allowed))throw Error('Requested nuclear capability not observed');
+
diff --git a/lorkan-evolve.cjs b/lorkan-evolve.cjs
