--- /dev/null
+++ b/packages/engine/src/LorkanArsenal.ts
@@ -0,0 +1,90 @@
+import {UnitType} from '@openfront/engine-api/game/GameTypes';
+import type {Intent} from '@openfront/engine-api/Schemas';
+import {PseudoRandom} from '@openfront/engine-lib/PseudoRandom';
+import type {Game,Player} from './game/Game';
+import {NationStructurePlacement} from './execution/nation/NationStructurePlacement';
+import {blastHitsFriendlyLand,enemyLandBlastCoverage,isNukeAlreadyLandingNear,isTrajectoryInterceptableBySam} from './execution/nation/NationNukePlanning';
+import {mirvGetsThrough} from './execution/nation/NationMIRVBehavior';
+
+export function arsenalDecision(g:Game,p:Player,strategy:number,cityTiles=4500):Intent|null{
+ const t=g.ticks(),cities=p.units(UnitType.City),factories=p.units(UnitType.Factory),ports=p.units(UnitType.Port),sams=p.units(UnitType.SAMLauncher),silos=p.units(UnitType.MissileSilo);
+ const enemies=g.players().filter(q=>q!==p&&!p.isFriendly(q,true)&&q.isAlive());
+ const afford=(type:UnitType)=>!g.config().isUnitDisabled(type)&&p.gold()>=g.unitInfo(type).cost(g,p);
+ const ready=(type:UnitType)=>p.units(type).filter(u=>u.isActive()&&!u.isUnderConstruction());
+ const incoming=p.incomingAttacks().reduce((n,a)=>n+a.troops(),0);
+ if(t%30===0&&incoming>p.troops()*.4&&p.units(UnitType.DefensePost).length<Math.max(1,Math.ceil(cities.length/2))&&afford(UnitType.DefensePost)){
+  const border=[...p.borderTiles()];
+  for(let k=0;k<40;k++){const tile=border[(t+k*97)%border.length];if(tile===undefined)continue;const valid=p.canBuild(UnitType.DefensePost,tile);if(valid!==false)return {type:'build_unit',unit:UnitType.DefensePost,tile:valid};}
+ }
+ const placement=new NationStructurePlacement(new PseudoRandom(t*7919+p.smallID()),g,p);let prepared=false;
+ function build(type:UnitType):Intent|null{
+  if(!afford(type))return null;
+  if(!prepared){placement.startRound();prepared=true;}
+  let tile=placement.spawnTile(type);
+  if(type===UnitType.Factory){
+   const ownStations=p.units(UnitType.City,UnitType.Port,UnitType.Factory),range2=g.config().trainStationMaxRange()**2,min2=g.config().trainStationMinRange()**2;
+   const tiles=[...p.tiles()],candidates:{tile:number;score:number}[]=[];
+   for(let k=0;k<160;k++){
+    const c=tiles[(t*17+k*997)%tiles.length];if(c===undefined)continue;
+    const reachable=ownStations.filter(u=>{const d=g.euclideanDistSquared(c,u.tile());return d>=min2&&d<=range2});
+    if(!reachable.some(u=>u.type()!==UnitType.Factory))continue;
+    const score=reachable.reduce((s,u)=>s+(u.type()===UnitType.Factory?1:4),0);
+    candidates.push({tile:c,score});
+   }
+   tile=null;
+   for(const c of candidates.sort((a,b)=>b.score-a.score).slice(0,16)){
+    if(p.canBuild(type,c.tile)!==false&&g.railNetwork().computeGhostRailPaths(type,c.tile).length>0){tile=c.tile;break;}
+   }
+  }
+  return tile===null?null:{type:'build_unit',unit:type,tile};
+ }
+ // Defend valuable infrastructure before discretionary spending when missiles are present.
+ const nuclearThreat=enemies.some(q=>q.units(UnitType.MissileSilo).length>0)||g.units(UnitType.AtomBomb,UnitType.HydrogenBomb,UnitType.MIRV).some(u=>!p.isFriendly(u.owner(),true));
+ if(t%30===0&&cities.length>=2){
+  const uncovered=p.units([UnitType.City,UnitType.Factory,UnitType.Port,UnitType.MissileSilo]).filter(u=>!sams.some(s=>g.euclideanDistSquared(s.tile(),u.tile())<=g.config().samRange(s.level())**2));
+  if(uncovered.length>=(nuclearThreat?1:4)&&sams.length<Math.max(1,Math.ceil(cities.length*.65))){const a=build(UnitType.SAMLauncher);if(a)return a;}
+ }
+ // A bounded nuclear budget: avoid friendly blasts, duplicate targets and interceptable single shots.
+ if(t%100===0&&ready(UnitType.MissileSilo).some(u=>!u.isInCooldown())&&cities.length>=3){
+  const targets=enemies.sort((a,b)=>b.units(UnitType.City).length-a.units(UnitType.City).length);
+  for(const q of targets.slice(0,3)){
+   const structures=q.units([UnitType.SAMLauncher,UnitType.MissileSilo,UnitType.Factory,UnitType.City]);
+   for(const unit of [UnitType.HydrogenBomb,UnitType.AtomBomb] as const){
+    if(!afford(unit)||p.gold()<g.unitInfo(unit).cost(g,p)*12n/10n)continue;
+    for(const u of structures.slice(0,8)){
+     const tile=u.tile();if(p.canBuild(unit,tile)===false||isNukeAlreadyLandingNear(g,tile,unit)||enemyLandBlastCoverage(g,p,tile,unit)<.45||blastHitsFriendlyLand(g,p,tile,unit))continue;
