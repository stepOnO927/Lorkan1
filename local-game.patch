+import {NodeGameMapLoader} from './tests/perf/fullgame/NodeGameMapLoader';
+import {lorkanDecision as oldPolicy} from './packages/engine/src/LorkanPolicyV02';
+import {lorkanDecision as newPolicy} from './packages/engine/src/LorkanPolicy';
+import fs from 'node:fs';
+const version=process.env.POLICY??'baseline',policy=version==='baseline'?oldPolicy:newPolicy;
+const rows:any[]=[];console.debug=()=>{};
+for(let i=0;i<Number(process.env.GAMES??4);i++){
+ const seed=i+Number(process.env.SEED_START??0);
+ const map=seed%2?GameMapType.Europe:GameMapType.World;
+ const config:any={gameMode:GameMode.FFA,gameType:GameType.Singleplayer,gameMap:map,gameMapSize:GameMapSize.Compact,difficulty:Difficulty.Impossible,nations:'default',bots:40,infiniteGold:false,infiniteTroops:false,instantBuild:false,randomSpawn:false,startingGold:Number(process.env.START_GOLD??0),donateGold:false,donateTroops:false};
+ const start:any={gameID:'LORKAN-TEST-'+seed,lobbyCreatedAt:0,config,players:[{clientID:'LOCALAI1',username:'Lorkan',isLobbyCreator:true,clanTag:null}]};
+ const files=await loadMapFiles(new NodeGameMapLoader('resources/maps'),map,GameMapSize.Compact);
+ let error='';const r=await createGameRunner(start,'LOCALAI1',files,u=>{if('errMsg'in u)error=u.errMsg});const g=r.game,actions:any={};const t0=Date.now();let maxTiles=0;
+ for(let t=0;t<Number(process.env.TICKS??3600);t++){
+  const a=version==='baseline'?oldPolicy(g,'LOCALAI1',1):newPolicy(g,'LOCALAI1',1,process.env.TUNING?JSON.parse(process.env.TUNING):undefined);if(a){const key=a.type==='build_unit'?a.unit:a.type;actions[key]=(actions[key]??0)+1;}
+  r.addTurn({turnNumber:t,intents:a?[{...a,clientID:'LOCALAI1'}]:[]});if(!r.executeNextTick()||error)throw Error(error||'tick failure');
+  const p=g.playerByClientID('LOCALAI1');maxTiles=Math.max(maxTiles,p?.numTilesOwned()??0);if(g.getWinner()||(p?.hasSpawned()&&!p.isAlive()))break;
+ }
+ const p=g.playerByClientID('LOCALAI1')!,winner:any=g.getWinner();
+ const stations=[...g.railNetwork().stationManager().getAll()].filter(s=>s.unit.owner()===p);
+ const result={version,seed,map,difficulty:config.difficulty,startingGold:config.startingGold,bots:config.bots,ticks:g.ticks(),win:typeof winner?.clientID==='function'&&winner.clientID()==='LOCALAI1',alive:p.isAlive(),tiles:p.numTilesOwned(),maxTiles,gold:String(p.gold()),trainGold:String(p.trainGold()),tradeGold:String(p.tradeGold()),factories:p.units(UnitType.Factory).length,connectedStations:stations.filter(s=>s.getRailroads().size>0).length,stations:stations.length,actions,seconds:(Date.now()-t0)/1000};
+ rows.push(result);console.log(JSON.stringify(result));fs.writeFileSync(`../../outputs/benchmark-${version}.json`,JSON.stringify(rows,null,2));
