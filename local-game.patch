+// Deterministic parameter search against maximum-difficulty opponents. Validation seeds are never used to rank training candidates.
+const fs=require('node:fs'),{spawnSync}=require('node:child_process');
+const file='packages/engine/src/LorkanTuning.json',out='../../outputs';
+let champion=JSON.parse(fs.readFileSync(file)),history=[];
+try{history=JSON.parse(fs.readFileSync(`${out}/evolution-report.json`)).generations??[];}catch{}
+try{champion=JSON.parse(fs.readFileSync(`${out}/lorkan-champion.json`)).params??champion;}catch{}
+const offset=history.length;
+const generations=Number(process.env.GENERATIONS||1),ticks=Number(process.env.TRAIN_TICKS||1800);
+function evaluate(profile,label,start){
+ const p=spawnSync(process.execPath,['--import','tsx','lorkan-benchmark.ts'],{env:{...process.env,POLICY:label,TUNING:JSON.stringify(profile),GAMES:'2',TICKS:String(ticks),START_GOLD:'0',SEED_START:String(start)},encoding:'utf8',windowsHide:true,maxBuffer:8000000});
+ if(p.status!==0)throw Error(p.stderr||p.stdout);
+ const rows=JSON.parse(fs.readFileSync(`${out}/benchmark-${label}.json`));
+ const score=rows.reduce((s,r)=>s+(r.win?100:0)+(r.alive?2:0)+r.maxTiles/10000+r.ticks/ticks*.25+Math.min(.2,Number(r.trainGold)/10000000),0)/rows.length;
+ console.log(JSON.stringify({label,score,alive:rows.filter(r=>r.alive).length,wins:rows.filter(r=>r.win).length}));return {score,rows};
+}
+for(let gen=0;gen<generations;gen++){
+ const generation=offset+gen+1;
+ fs.writeFileSync(`${out}/evolution-report.json`,JSON.stringify({method:'Bounded parameter search, not neural-model training',difficulty:'Impossible',running:true,currentGeneration:generation,ticks,generations:history},null,2));
+ if(process.env.LEARN_WINNERS==='1'){
+  const study=spawnSync(process.execPath,['--import','tsx','lorkan-winners.ts'],{env:{...process.env,GAMES:'1',TICKS:'15000',STUDY_START:String(generation*2)},encoding:'utf8',windowsHide:true,maxBuffer:8000000});
+  if(study.status!==0)throw Error(study.stderr||study.stdout);console.log(study.stdout);
+ }
+ const stamp=Date.now().toString(36),baseSeed=100+(generation-1)*10;
+ const candidates=[champion,{...champion,expansionScale:Math.max(.5,champion.expansionScale-.15),attackScale:Math.min(1.5,champion.attackScale+.1)},{...champion,expansionScale:Math.min(1.5,champion.expansionScale+.15),attackScale:Math.max(.7,champion.attackScale-.1),cityTiles:3500}];
+ let winnerProvenance=[];
+ try{const proposal=JSON.parse(fs.readFileSync(`${out}/winner-proposal.json`));const p=proposal.params;if(Array.isArray(proposal.provenance)&&proposal.provenance.length&&p.expansionScale>=.5&&p.expansionScale<=1.5&&p.attackScale>=.7&&p.attackScale<=1.5&&p.cityTiles>=2500&&p.cityTiles<=7000){candidates.push(p);winnerProvenance=proposal.provenance;}}catch{}
+ const train=candidates.map((p,i)=>evaluate(p,`evolve-${stamp}-${i}`,baseSeed));
+ let best=train.reduce((b,x,i)=>x.score>train[b].score?i:b,0),accepted=false,validation=null;
+ if(best!==0){const old=evaluate(champion,`validate-${stamp}-old`,1000+(generation-1)*10),next=evaluate(candidates[best],`validate-${stamp}-new`,1000+(generation-1)*10);validation={old:old.score,next:next.score};accepted=next.score>old.score&&next.rows.filter(r=>r.win).length>=old.rows.filter(r=>r.win).length;if(accepted)champion=candidates[best];}
+ history.push({gen:generation,candidates,winnerProvenance,trainingScores:train.map(x=>x.score),best,validation,accepted,champion});
+ fs.writeFileSync(`${out}/lorkan-champion.json`,JSON.stringify({generation,params:champion,accepted},null,2));
+ fs.writeFileSync(`${out}/evolution-report.json`,JSON.stringify({method:'Bounded parameter search, not neural-model training',difficulty:'Impossible',running:gen<generations-1,currentGeneration:generation,ticks,generations:history},null,2));
+ console.log(JSON.stringify({generation,accepted,champion}));
+}
