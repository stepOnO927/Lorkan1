+import { GameType, UnitType } from '@openfront/engine-api/game/GameTypes';
+import type { Intent } from '@openfront/engine-api/Schemas';
+import type { Player, Game } from './game/Game';
+export function lorkanDecision(g:Game,clientID:string,strategy:number):Intent|null {
+ if(g.config().gameConfig().gameType!==GameType.Singleplayer||strategy<0||strategy>3||g.ticks()%10!==0)return null;
+ const p=g.playerByClientID(clientID);if(!p)return null;
+ if(!p.hasSpawned()){
+  const cx=Math.floor(g.width()/2),cy=Math.floor(g.height()/2);
+  for(let k=0;k<10000;k++){const x=(cx+k*97)%g.width(),y=(cy+k*53)%g.height(),tile=g.ref(x,y);if(g.isLand(tile)&&!g.hasOwner(tile)&&!g.isBorder(tile))return {type:'spawn',tile};}return null;
+ }
+ if(!p.isAlive())return null;
+ const t=g.ticks(),s=strategy,near=p.nearby(),others=g.players().filter(q=>q!==p&&q.isAlive());
+ if(s===3&&t%100===0&&others.length>2&&p.allies().length===0){const req=p.incomingAllianceRequests()[0];const q=req?.requestor()??others.filter(q=>p.canSendAllianceRequest(q)).sort((a,b)=>a.numTilesOwned()-b.numTilesOwned())[0];if(q)return {type:'allianceRequest',recipient:q.id()};}
+ if(others.length===1&&p.isAlliedWith(others[0]))return {type:'breakAlliance',recipient:others[0].id()};
+ if(t%[150,30,100,60][s]===0){
+  const types=s===1?[UnitType.City,UnitType.Port,UnitType.Factory]:s===2?[UnitType.DefensePost,UnitType.City,UnitType.Port]:[UnitType.City,UnitType.Port,UnitType.DefensePost];
+  const tiles=[...p.tiles()];
+  for(const unit of types){if(p.gold()<g.unitInfo(unit).cost(g,p))continue;for(let k=0;k<60;k++){const tile=tiles[(t*17+k*97)%tiles.length];if(tile!==undefined&&p.canBuild(unit,tile)!==false)return {type:'build_unit',unit,tile};}}
+ }
+ const has=(id:string|null)=>p.outgoingAttacks().some(a=>a.target().id()===id);
+ const enemies=near.filter((q):q is Player=>q.isPlayer()&&!p.isFriendly(q,true));
+ const target=enemies.sort((a,b)=>a.troops()-b.troops())[0];const neutral=near.some(q=>!q.isPlayer());
+ if(target&&(!neutral||s===2)&&p.troops()>target.troops()*[1.25,1.8,.75,1.35][s]&&!has(target.id()))return {type:'attack',targetID:target.id(),troops:p.troops()*[.35,.25,.55,.3][s]};
+ if(neutral&&!has(g.terraNullius().id())&&p.troops()>300)return {type:'attack',targetID:null,troops:p.troops()*[.45,.18,.25,.28][s]};
+ if(t%100===0&&p.troops()>10000&&p.units(UnitType.TransportShip).length===0){for(const q of others.filter(q=>!p.isFriendly(q,true)).sort((a,b)=>a.troops()-b.troops())){const shore=[...q.borderTiles()].find(tile=>g.isShore(tile));if(shore!==undefined)return {type:'boat',dst:shore,troops:p.troops()*.25};}}
+ return null;
+}
