{
  "manifest_version": 3,
  "name": "Lorkan1 私人房间协作候选",
  "version": "1.6.0",
  "description": "私人房间0至25个独立访客AI：谨慎结盟、一键启动、玩家ID复仇、地图与列表追杀、AI互保及护主。",
  "permissions": [
    "storage",
    "activeTab",
    "offscreen"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://frontwars.io/*",
        "https://www.frontwars.io/*"
      ],
      "js": [
        "guest-bootstrap.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://frontwars.io/*",
        "https://www.frontwars.io/*"
      ],
      "js": [
        "native-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://frontwars.io/*",
        "https://www.frontwars.io/*"
      ],
      "js": [
        "menu.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 Lorkan 私人房间托管菜单",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "116"
}